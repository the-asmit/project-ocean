# Ocean-Viz backend configuration
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
#   cp backend/.env.example backend/.env

# --- Copernicus Marine Service (required) -----------------------------------
# Free account: https://data.marine.copernicus.eu/register
# Used by backend/adapters/{glorys,bathymetry}.py to fetch GLORYS tiles.
# Only needed when a requested region/date/variable is NOT already in
# backend/cache/ — a warm cache serves fully offline.
CMEMS_USERNAME=your_copernicus_username
CMEMS_PASSWORD=your_copernicus_password
