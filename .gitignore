# ---------------------------------------------------------------------------
# Data cache — regenerated on demand from Copernicus Marine.
# These are large binaries and are NOT source. `backend/main.py` refetches
# anything missing, so an empty cache is a valid clean checkout.
# ---------------------------------------------------------------------------
backend/cache/raw/
backend/cache/derived/
*.nc
*.nc4
*.zarr/
*.grib
*.grib2

# derived render blobs produced by the adapters
spike-real-data/public/data/
spike-real-data/data/

